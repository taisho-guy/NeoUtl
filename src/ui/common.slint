import { IconDisplay, IconSet, Icon } from "@lucide";

export global IconLookup {
    public pure function icon-for(key: string) -> Icon {
        if (key == "trash") { return IconSet.Trash2; }
        if (key == "scissors") { return IconSet.Scissors; }
        if (key == "copy-plus") { return IconSet.CopyPlus; }
        if (key == "copy") { return IconSet.Copy; }
        if (key == "link") { return IconSet.Link2; }
        if (key == "circle-plus") { return IconSet.CirclePlus; }
        if (key == "undo") { return IconSet.Undo2; }
        if (key == "redo") { return IconSet.Redo2; }
        if (key == "paste") { return IconSet.ClipboardPaste; }
        return IconSet.Circle;
    }
}

export global KeyUtil {
    public pure function normalize-key(event: KeyEvent) -> string {
        if (event.text == Key.Delete) { return "Delete"; }
        if (event.text == Key.LeftArrow) { return "Left"; }
        if (event.text == Key.RightArrow) { return "Right"; }
        if (event.text == Key.Home) { return "Home"; }
        if (event.text == Key.End) { return "End"; }
        if (event.text == Key.Escape) { return "Escape"; }
        if (event.text == Key.Tab) { return "Tab"; }
        if (event.text == Key.F2) { return "F2"; }
        if (event.text == Key.F3) { return "F3"; }
        if (event.text == Key.F9) { return "F9"; }
        if (event.text == Key.F10) { return "F10"; }
        if (event.text == " ") { return "Space"; }
        return event.text;
    }
}

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <color> stroke: #e0e0e0;
    in property <length> icon-size: 18px;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: touch.pressed ? #303038 : touch.has-hover ? #26262c : transparent;

    IconDisplay {
        x: (root.width - root.icon-size) / 2;
        y: (root.height - root.icon-size) / 2;
        icon: root.icon;
        stroke: root.stroke;
        size: root.icon-size;
    }

    touch := TouchArea {
        clicked() => { root.clicked(); }
    }
}

export component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <Icon> icon: IconSet.Circle;
    callback clicked();

    width: 104px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.primary ? #3a5fd9 : #33333c;
    background: root.primary
        ? (touch.pressed ? #2244aa : touch.has-hover ? #3a5fd9 : #2a4db8)
        : (touch.pressed ? #202028 : touch.has-hover ? #26262c : #1a1a20);

    HorizontalLayout {
        alignment: center;
        spacing: 5px;

        IconDisplay {
            icon: root.icon;
            stroke: #ffffff;
            size: 14px;
            vertical-stretch: 0;
        }

        Text {
            text: root.label;
            color: #ffffff;
            font-size: 11px;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
    }

    touch := TouchArea {
        clicked() => { root.clicked(); }
    }
}
