
import { Icon, IconDisplay, IconSet } from "@lucide";

export global SettingsIconLookup {
    public pure function icon-for(index: int) -> Icon {
        if (index == 0) { return IconSet.Settings; }
        if (index == 1) { return IconSet.Palette; }
        if (index == 2) { return IconSet.Gauge; }
        if (index == 3) { return IconSet.HardDrive; }
        if (index == 4) { return IconSet.Timeline; }
        return IconSet.Video;
    }
}

export component SettingsSidebar inherits Rectangle {
    in property <int> selected: 0;
    in property <[string]> categories: [];
    callback select(int);

    width: 160px;
    background: #16161b;

    VerticalLayout {
        padding: 4px;
        spacing: 2px;

        for c[i] in root.categories: Rectangle {
            height: 30px;
            border-radius: 3px;
            background: i == root.selected ? #2a4db8 : (touch.has-hover ? #202028 : transparent);

            IconDisplay {
                x: 8px;
                y: 7px;
                icon: SettingsIconLookup.icon-for(i);
                stroke: i == root.selected ? #ffffff : #9da8c7;
                size: 15px;
                vertical-stretch: 0;
            }

            Text {
                x: 31px;
                text: c;
                color: i == root.selected ? #ffffff : #b0b0ba;
                font-size: 11px;
                vertical-alignment: center;
                height: 100%;
            }

            touch := TouchArea {
                clicked() => { root.select(i); }
            }
        }
    }
}
