import { EffectRow, ParamRow, TrackOption } from "types.slint";
import { Slider, ComboBox } from "std-widgets.slint";

// AviQtl(ParamControl.qml)の左右対称構成を踏襲するが、左右の意味は
// 「現在ハイライトされている区間の開始値・終了値」を独立して編集する方式へ変更する。
// 左右は同一valueの重複操作面ではなく、別々の絶対フレームへの書き込みとなる
// （書き込み先フレームはRust側resolve_segment()が確定したsegment-start/end-frame）。
component PropertyRow inherits Rectangle {
    in property <string> label;
    in property <float> segment-start-value;
    in property <float> segment-end-value;
    in property <float> min: -1000;
    in property <float> max: 1000;
    in property <float> drag-sensitivity: 1;
    callback start-changed(float);
    callback end-changed(float);
    callback commit-start();
    callback commit-end();
    callback release();
    // ラベルクリックでイージングウィンドウを要求する。
    callback label-clicked();

    height: 22px;

    function clamp(v: float) -> float {
        return v < min ? min : v > max ? max : v;
    }

    property <length> anchor-x: 0;
    property <length> anchor-y: 0;
    // Sliderはpointer-eventを公開しないため、changed連続発火の間隔でドラッグ
    // セッションを判定する。最後のchangedから150ms無操作でreleaseとみなす。
    // 左右セッションは独立フレームへの書き込みのため、タイマーも左右別個に持つ。
    property <bool> left-active: false;
    property <bool> right-active: false;

    left-timeout := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            root.left-active = false;
            self.running = false;
            root.release();
        }
    }

    right-timeout := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            root.right-active = false;
            self.running = false;
            root.release();
        }
    }

    function push-start(v: float) {
        if (!root.left-active) {
            root.left-active = true;
            root.commit-start();
        }
        left-timeout.running = false;
        left-timeout.running = true;
        root.start-changed(root.clamp(v));
    }

    function push-end(v: float) {
        if (!root.right-active) {
            root.right-active = true;
            root.commit-end();
        }
        right-timeout.running = false;
        right-timeout.running = true;
        root.end-changed(root.clamp(v));
    }

    HorizontalLayout {
        spacing: 4px;

        slider-l := Slider {
            minimum: root.min;
            maximum: root.max;
            value: root.clamp(root.segment-start-value);
            changed(v) => { root.push-start(v); }
        }

        value-l := Rectangle {
            width: 56px;
            border-radius: 3px;
            background: drag-l.pressed ? #22222a : #16161b;
            border-width: 1px;
            border-color: #303038;

            input-l := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: 100%;
                text: root.segment-start-value;
                color: #dde3ee;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: InputType.decimal;
                accepted => { root.push-start(self.text.to-float()); }
            }

            drag-l := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.none : MouseCursor.default;
                clicked => { input-l.focus(); }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.anchor-x = self.mouse-x;
                            root.anchor-y = self.mouse-y;
                            root.commit-start();
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.push-start(root.segment-start-value
                            + (self.mouse-x - root.anchor-x) / 1px * root.drag-sensitivity
                            - (self.mouse-y - root.anchor-y) / 1px * root.drag-sensitivity);
                        root.anchor-x = self.mouse-x;
                        root.anchor-y = self.mouse-y;
                    }
                }
            }
        }

        label-cell := Rectangle {
            width: 74px;
            border-radius: 3px;
            background: label-touch.pressed ? #1c1c22 : label-touch.has-hover ? #262630 : #202026;

            Text {
                text: root.label;
                color: #b0b0ba;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }

            label-touch := TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.label-clicked();
                    }
                }
            }
        }

        value-r := Rectangle {
            width: 56px;
            border-radius: 3px;
            background: drag-r.pressed ? #22222a : #16161b;
            border-width: 1px;
            border-color: #303038;

            input-r := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: 100%;
                text: root.segment-end-value;
                color: #dde3ee;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: InputType.decimal;
                accepted => { root.push-end(self.text.to-float()); }
            }

            drag-r := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.none : MouseCursor.default;
                clicked => { input-r.focus(); }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.anchor-x = self.mouse-x;
                            root.anchor-y = self.mouse-y;
                            root.commit-end();
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.push-end(root.segment-end-value
                            + (self.mouse-x - root.anchor-x) / 1px * root.drag-sensitivity
                            - (self.mouse-y - root.anchor-y) / 1px * root.drag-sensitivity);
                        root.anchor-x = self.mouse-x;
                        root.anchor-y = self.mouse-y;
                    }
                }
            }
        }

        slider-r := Slider {
            minimum: root.min;
            maximum: root.max;
            value: root.clamp(root.segment-end-value);
            changed(v) => { root.push-end(v); }
        }
    }
}

// 全パラメータ共通の中間点区間トラック。boundary-framesは常に2要素以上
// （先頭=clip-start、末尾=clip-end）で、その全点を常時描画する
// （両端は中間点が0件の状態でも「実在する境界点」として常に可視化する）。
// segment-start-frame/segment-end-frameで指定された区間だけを照明表示し、
// current-frameの位置へ縦線を引く。区間探索はRust側resolve_segment()が
// 確定済みの値をそのまま使うため、このコンポーネントは純粋な描画専用に留める。
component KeyframeTrack inherits Rectangle {
    in property <[int]> boundary-frames;
    // 数直線が表す絶対範囲。boundary-frames[0]/[last]と常に一致する
    // （オブジェクト固有のclip_start/clip_end。プロジェクト全体のフレーム数ではない）。
    in property <int> clip-start-frame: 0;
    in property <int> clip-end-frame: 1;
    in property <int> current-frame: 0;
    in property <int> segment-start-frame: 0;
    in property <int> segment-end-frame: 1;
    // 引数: クリック位置から算出したフレーム番号、または既存境界点のフレーム。
    callback point-clicked(int);
    // 引数: 追加先フレーム。空き領域の右クリックでのみ発火する。
    callback add-point(int);
    // 引数: 削除対象フレーム。既存中間点（両端を除く）の右クリックでのみ発火する。
    callback remove-point(int);
    // 引数: ドラッグ開始時点のフレーム。スナップショット確定用で、値の変更は伴わない。
    callback drag-start(int);
    // 引数: (旧フレーム, 新フレーム)。中間点ドラッグ中、位置更新のたび発火する。
    callback drag-point(int, int);
    // 引数: (既存点上か, 対象/追加先フレーム, メニュー表示位置x, メニュー表示位置y)。
    callback context-menu(bool, int, length, length);

    height: 12px;
    border-radius: 2px;
    background: #131318;
    border-width: 1px;
    border-color: #24242c;
    clip: true;

    // 0%=clip-start-frame、100%=clip-end-frameとなる区間ローカル座標系。
    function frac(f: int) -> float {
        return root.clip-end-frame > root.clip-start-frame
            ? (f - root.clip-start-frame) / (root.clip-end-frame - root.clip-start-frame)
            : 0;
    }

    function frame-at(x: length) -> int {
        return max(root.clip-start-frame, min(root.clip-end-frame,
            root.clip-start-frame
                + (x / root.width * (root.clip-end-frame - root.clip-start-frame) + 0.5)));
    }

    TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.point-clicked(root.frame-at(self.mouse-x));
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context-menu(false, root.frame-at(self.mouse-x),
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // 現在区間のハイライト（照明表示）
    Rectangle {
        x: root.width * root.frac(root.segment-start-frame);
        width: root.width * (root.frac(root.segment-end-frame) - root.frac(root.segment-start-frame));
        height: 100%;
        background: #2a4db8;
        opacity: 0.35;
    }

    // 現在フレーム位置の縦線（タイムライン上の再生位置プレビューと同期）
    Rectangle {
        x: root.width * root.frac(root.current-frame) - 0.5px;
        width: 1px;
        height: 100%;
        background: #e8e8ee;
    }

    // 境界点。両端（配列の先頭・末尾）は常時可視、中間は登録済みの中間点のみ。
    // 両端は追加・削除・ドラッグ非対応（クリップの実寸境界のため）。
    for f[idx] in root.boundary-frames: Rectangle {
        x: root.width * root.frac(f) - 4px;
        y: parent.height / 2 - 4px;
        width: 8px;
        height: 8px;

        property <bool> is-endpoint: idx == 0 || idx == root.boundary-frames.length - 1;

        Path {
            width: 100%;
            height: 100%;
            commands: "M 4 0 L 8 4 L 4 8 L 0 4 Z";
            fill: is-endpoint ? #6a6a76 : #3a6df0;
        }

        point-touch := TouchArea {
            property <bool> dragged: false;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        self.dragged = false;
                    }
                    if (event.kind == PointerEventKind.up) {
                        if (!self.dragged) {
                            root.point-clicked(f);
                        }
                        self.dragged = false;
                    }
                }
                if (!is-endpoint && event.button == PointerEventButton.right
                    && event.kind == PointerEventKind.down) {
                    root.context-menu(true, f,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }

            moved => {
                if (!is-endpoint && self.pressed) {
                    if (!self.dragged) {
                        self.dragged = true;
                        root.drag-start(f);
                    }
                    if (root.frame-at(self.absolute-position.x + self.mouse-x - root.absolute-position.x) != f) {
                        root.drag-point(f,
                            root.frame-at(self.absolute-position.x + self.mouse-x - root.absolute-position.x));
                    }
                }
            }
        }
    }
}

component ToggleField inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    callback toggled();

    height: 22px;

    Text {
        text: label;
        color: #b0b0ba;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }

    Rectangle {
        x: parent.width - 36px;
        width: 36px;
        height: 18px;
        border-radius: 9px;
        background: checked ? #2a4db8 : #303038;

        Rectangle {
            x: checked ? parent.width - 16px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: #e8e8ee;
        }

        TouchArea {
            clicked() => { root.toggled(); }
        }
    }
}

component SectionHeader inherits Text {
    color: #55555e;
    font-size: 10px;
    font-weight: 700;
    height: 18px;
    vertical-alignment: center;
}

component MenuItem inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 24px;
    background: touch.has-hover ? #2a2a32 : transparent;

    Text {
        x: 8px;
        text: label;
        color: #c8c8d2;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// kind: 0=Float, 1=Bool, 2=Color, 3=Enum, 4=Text, 5=FilePath, 6=Track
component ParamField inherits Rectangle {
    in property <ParamRow> data;
    in property <int> current-frame: 0;
    // 引数: 区間開始フレームへ書き込む値、区間終了フレームへ書き込む値。
    // 対象フレームはdata.segment-start-frame/segment-end-frameへ呼び出し側が付与する。
    callback changed-segment-start(float);
    callback changed-segment-end(float);
    callback changed-bool(bool);
    callback changed-text(string);
    callback changed-enum(int);
    callback changed-path(string);
    callback pick-path();
    callback changed-track(int);
    callback commit();
    callback release();
    // 引数: 対象フレーム。常に実在する境界点（KeyframeTrack.boundary-framesの要素、
    // またはラベルクリック時のdata.segment-start-frame）のみが渡る。
    callback edit-keyframes(int);
    // 以下4件はKeyframeTrackの同名callbackをそのまま中継する（ParamField自身は
    // group/key/effect-indexを持たないため、識別情報の付与は呼び出し元に委ねる）。
    callback add-keyframe(int);
    callback remove-keyframe(int);
    callback keyframe-drag-start(int);
    callback keyframe-drag(int, int);
    callback keyframe-context-menu(bool, int, length, length);

    height: (data.kind == 4 || data.kind == 5) ? 44px : (data.kind == 0 || data.kind == 2) ? 34px : 22px;

    if data.kind == 0 || data.kind == 2: VerticalLayout {
        spacing: 2px;
        PropertyRow {
            label: data.label;
            segment-start-value: data.segment-start-value;
            segment-end-value: data.segment-end-value;
            min: data.kind == 2 ? 0 : data.min;
            max: data.kind == 2 ? 1 : data.max;
            start-changed(v) => { root.changed-segment-start(v); }
            end-changed(v) => { root.changed-segment-end(v); }
            commit-start => { root.commit(); }
            commit-end => { root.commit(); }
            release => { root.release(); }
            // ラベルクリックは「現在ハイライト中の区間」の開始点（＝実在する境界点）を
            // 対象に区間編集パネルを開く。-1（＝任意の再生位置）は使わない。
            label-clicked => { root.edit-keyframes(data.segment-start-frame); }
        }

        KeyframeTrack {
            boundary-frames: data.boundary-frames;
            clip-start-frame: data.boundary-frames[0];
            clip-end-frame: data.boundary-frames[data.boundary-frames.length - 1];
            current-frame: root.current-frame;
            segment-start-frame: data.segment-start-frame;
            segment-end-frame: data.segment-end-frame;
            point-clicked(frame) => { root.edit-keyframes(frame); }
            add-point(frame) => { root.add-keyframe(frame); }
            remove-point(frame) => { root.remove-keyframe(frame); }
            drag-start(frame) => { root.keyframe-drag-start(frame); }
            drag-point(o, n) => { root.keyframe-drag(o, n); }
            context-menu(is-point, frame, x, y) => { root.keyframe-context-menu(is-point, frame, x, y); }
        }
    }

    if data.kind == 1: ToggleField {
        label: data.label;
        checked: data.value > 0.5;
        toggled => { root.changed-bool(data.value <= 0.5); }
    }

    if data.kind == 3: VerticalLayout {
        spacing: 2px;
        Text {
            text: data.label;
            color: #c8c8d2;
            font-size: 11px;
        }
        ComboBox {
            model: data.enum-options;
            current-index: data.enum-index;
            selected(value) => { root.changed-enum(self.current-index); }
        }
    }

    if data.kind == 4: Rectangle {
        height: 44px;
        border-radius: 3px;
        background: #1e1e24;
        border-width: 1px;
        border-color: #303038;

        TextInput {
            x: 6px;
            y: 4px;
            width: parent.width - 12px;
            height: parent.height - 8px;
            text: data.text;
            color: #dde3ee;
            font-size: 11px;
            wrap: word-wrap;
            accepted => { root.changed-text(self.text); }
        }
    }

    if data.kind == 5: HorizontalLayout {
        height: 44px;
        spacing: 4px;
        Rectangle {
            border-radius: 3px;
            background: #1e1e24;
            border-width: 1px;
            border-color: #303038;

            TextInput {
                x: 6px;
                y: 4px;
                width: parent.width - 12px;
                height: parent.height - 8px;
                text: data.text;
                color: #dde3ee;
                font-size: 11px;
                wrap: no-wrap;
                accepted => { root.changed-path(self.text); }
            }
        }
        Rectangle {
            width: 64px;
            border-radius: 3px;
            background: #2a2a32;
            border-width: 1px;
            border-color: #383840;
            Text {
                text: "参照...";
                color: #dde3ee;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.pick-path(); }
            }
        }
    }

    if data.kind == 6: VerticalLayout {
        spacing: 2px;
        Text {
            text: data.label;
            color: #c8c8d2;
            font-size: 11px;
        }
        ComboBox {
            model: data.track-names;
            current-index: data.enum-index;
            selected(value) => {
                root.changed-track(self.current-index >= 0 && self.current-index < data.track-options.length
                    ? data.track-options[self.current-index].id
                    : -1);
            }
        }
    }
}

export component PropertiesWindow inherits Window {
    title: "NeoUtl - オブジェクト設定";
    preferred-width: 900px;
    preferred-height: 640px;
    background: #0e0e12;

    in-out property <int> object-id: -1;
    in-out property <float> stage-width: 1920;
    in-out property <float> stage-height: 1080;
    in-out property <int> total-frames: 300;

    in-out property <bool> has-transform: false;
    in-out property <bool> has-text: false;
    in-out property <bool> has-shape: false;
    in-out property <bool> has-audio: false;
    // タイムラインのプレビュー再生位置（絶対フレーム）。KeyframeTrackの縦線描画に使う。
    in-out property <int> current-frame: 0;

    in-out property <[ParamRow]> object-params: [];
    in-out property <[EffectRow]> effects: [];
    in-out property <[ParamRow]> params: [];

    property <int> drag-source-index: -1;
    property <int> drag-target-index: -1;

    property <int> menu-index: -1;
    property <bool> menu-visible: false;
    property <length> menu-x: 0;
    property <length> menu-y: 0;

    property <bool> is-dragging-param: false;

    // 中間点の追加・削除メニュー（KeyframeTrackの右クリックから開く）。
    // kf-menu-is-add: true=空き領域右クリック（追加）, false=既存中間点右クリック（削除）。
    property <bool> kf-menu-visible: false;
    property <bool> kf-menu-is-add: false;
    property <length> kf-menu-x: 0;
    property <length> kf-menu-y: 0;
    property <string> kf-menu-group: "";
    property <string> kf-menu-key: "";
    property <int> kf-menu-effect-index: -1;
    property <int> kf-menu-frame: -1;

    // 引数: (group, key, effect-index, frame)。frameへ中間点を1件追加/削除する。
    callback add-midpoint(string, string, int, int);
    callback remove-midpoint(string, string, int, int);
    // 引数: (group, key, effect-index)。ドラッグ開始時に一度だけ発火し、undo用スナップショットを確定する。
    callback commit-midpoint-drag(string, string, int);
    // 引数: (group, key, effect-index, old-frame, new-frame)。中間点をドラッグ移動する。
    callback move-midpoint(string, string, int, int, int);

    // 引数: (group, key, frame, value)。frameはdata.segment-start-frame/segment-end-frameのいずれか。
    callback set-object-param-segment(string, string, int, float);
    callback set-object-param-bool(string, string, bool);
    callback set-object-param-text(string, string, string);
    callback commit-object-param(string, string);
    callback set-effect-enabled(int, bool);
    callback remove-effect(int);
    // 引数: (effect-index, key, frame, value)。
    callback set-param-segment(int, string, int, float);
    callback set-param-bool(int, string, bool);
    // 引数: (effect-index, key, selected-index)。kind==Enumの選択確定。
    callback set-param-enum(int, string, int);
    // 引数: (effect-index, key, text)。kind==FilePathのテキスト欄直接編集確定。
    callback set-param-text(int, string, string);
    // 引数: (effect-index, key)。「参照...」ボタン押下、ネイティブファイルダイアログをRust側で開く。
    callback pick-param-file(int, string);
    // 引数: (effect-index, key, selected-object-id)。kind==Trackの選択確定。
    callback set-param-track(int, string, int);
    callback commit-param(int, string);
    callback add-effect(string);
    callback move-effect(int, int);
    callback copy-effect(int);
    callback paste-effect(int);
    callback duplicate-effect(int);
    callback open-effect-add-dialog();
    // 引数: (group, key, effect-index, frame)。frameは常に実在する境界点
    // （clip-start・clip-end・既存中間点のいずれか）であり、任意のフレームは渡らない。
    callback open-keyframe-editor(string, string, int, int);

    if object-id < 0: Text {
        text: "オブジェクトが選択されていません";
        color: #55555e;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    if object-id >= 0: HorizontalLayout {
        Rectangle {
            width: 180px;
            background: #131318;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;
                    SectionHeader {
                        text: "エフェクト";
                        vertical-alignment: center;
                        height: 100%;
                    }

                    Rectangle {
                        width: 44px;
                        height: 18px;
                        border-radius: 3px;
                        background: #1e1e24;
                        border-width: 1px;
                        border-color: #303038;
                        Text {
                            text: "追加";
                            color: #8a8a96;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        TouchArea {
                            clicked() => { root.open-effect-add-dialog(); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #24242c;
                }

                Flickable {
                    // ビュー全体を指で掴んでパンする挙動を禁止する。ホイール操作のみ
                    // スクロールを許可し、クリックドラッグはeff行の並び替え専用にする。
                    interactive: false;

                    VerticalLayout {
                        spacing: 2px;

                        for eff[i] in root.effects: Rectangle {
                            height: 26px;
                            border-radius: 3px;
                            background: i == root.drag-target-index && root.drag-source-index >= 0
                                && root.drag-source-index != i
                                ? #2a4db8
                                : row-touch.has-hover ? #1c1c22 : #16161b;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 6px;

                                ToggleField {
                                    width: 26px;
                                    label: "";
                                    checked: eff.enabled;
                                    toggled => { root.set-effect-enabled(eff.index, !eff.enabled); }
                                }

                                Text {
                                    text: eff.name;
                                    color: #c8c8d2;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    height: 100%;
                                    overflow: elide;
                                }
                            }

                            row-touch := TouchArea {
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left) {
                                        if (event.kind == PointerEventKind.down) {
                                            root.drag-source-index = eff.index;
                                            root.drag-target-index = eff.index;
                                        }
                                        if (event.kind == PointerEventKind.up) {
                                            if (root.drag-source-index >= 0
                                                && root.drag-target-index >= 0
                                                && root.drag-target-index != root.drag-source-index) {
                                                root.move-effect(root.drag-source-index, root.drag-target-index);
                                            }
                                            root.drag-source-index = -1;
                                            root.drag-target-index = -1;
                                        }
                                    }
                                    if (event.button == PointerEventButton.right
                                        && event.kind == PointerEventKind.down) {
                                        root.menu-index = eff.index;
                                        root.menu-x = self.absolute-position.x + self.mouse-x;
                                        root.menu-y = self.absolute-position.y + self.mouse-y;
                                        root.menu-visible = true;
                                    }
                                }
                                moved => {
                                    if (self.pressed && root.drag-source-index >= 0) {
                                        root.drag-target-index = eff.index;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: #24242c;
        }

        Flickable {
            // ビュー全体を指で掴んでパンする挙動を禁止する。ホイール操作のみ
            // スクロールを許可する（is-dragging-param判定は不要になったため削除）。
            interactive: false;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                for p[j] in root.object-params: Rectangle {
                    height: (j == 0 || p.group != root.object-params[j - 1].group ? 26px : 0px)
                        + ((p.kind == 4 || p.kind == 5) ? 44px : (p.kind == 0 || p.kind == 2) ? 34px : 22px);
                    clip: true;

                    VerticalLayout {
                        spacing: 4px;

                        if j == 0 || p.group != root.object-params[j - 1].group: SectionHeader {
                            text: p.group;
                        }

                        ParamField {
                            data: p;
                            current-frame: root.current-frame;
                            changed-segment-start(v) => { root.set-object-param-segment(p.group, p.key, p.segment-start-frame, v); }
                            changed-segment-end(v) => { root.set-object-param-segment(p.group, p.key, p.segment-end-frame, v); }
                            changed-bool(v) => { root.set-object-param-bool(p.group, p.key, v); }
                            changed-text(v) => { root.set-object-param-text(p.group, p.key, v); }
                            commit => {
                                root.is-dragging-param = true;
                                root.commit-object-param(p.group, p.key);
                            }
                            release => { root.is-dragging-param = false; }
                            edit-keyframes(frame) => { root.open-keyframe-editor(p.group, p.key, -1, frame); }
                            add-keyframe(frame) => { root.add-midpoint(p.group, p.key, -1, frame); }
                            remove-keyframe(frame) => { root.remove-midpoint(p.group, p.key, -1, frame); }
                            keyframe-drag-start(frame) => { root.commit-midpoint-drag(p.group, p.key, -1); }
                            keyframe-drag(o, n) => { root.move-midpoint(p.group, p.key, -1, o, n); }
                            keyframe-context-menu(is-point, frame, x, y) => {
                                root.kf-menu-visible = true;
                                root.kf-menu-is-add = !is-point;
                                root.kf-menu-frame = frame;
                                root.kf-menu-group = p.group;
                                root.kf-menu-key = p.key;
                                root.kf-menu-effect-index = -1;
                                root.kf-menu-x = x;
                                root.kf-menu-y = y;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #24242c;
                }

                for eff[i] in root.effects: VerticalLayout {
                    spacing: 2px;

                    SectionHeader {
                        text: eff.name;
                    }

                    for p[j] in root.params: Rectangle {
                        height: p.effect-index != eff.index ? 0px
                            : (p.kind == 4 || p.kind == 5) ? 44px : (p.kind == 0 || p.kind == 2) ? 34px : 22px;
                        clip: true;

                        if p.effect-index == eff.index: ParamField {
                            data: p;
                            current-frame: root.current-frame;
                            changed-segment-start(v) => { root.set-param-segment(eff.index, p.key, p.segment-start-frame, v); }
                            changed-segment-end(v) => { root.set-param-segment(eff.index, p.key, p.segment-end-frame, v); }
                            changed-bool(v) => { root.set-param-bool(eff.index, p.key, v); }
                            changed-enum(v) => { root.set-param-enum(eff.index, p.key, v); }
                            changed-path(v) => { root.set-param-text(eff.index, p.key, v); }
                            pick-path => { root.pick-param-file(eff.index, p.key); }
                            changed-track(v) => { root.set-param-track(eff.index, p.key, v); }
                            commit => {
                                root.is-dragging-param = true;
                                root.commit-param(eff.index, p.key);
                            }
                            release => { root.is-dragging-param = false; }
                            edit-keyframes(frame) => { root.open-keyframe-editor(p.group, p.key, eff.index, frame); }
                            add-keyframe(frame) => { root.add-midpoint(p.group, p.key, eff.index, frame); }
                            remove-keyframe(frame) => { root.remove-midpoint(p.group, p.key, eff.index, frame); }
                            keyframe-drag-start(frame) => { root.commit-midpoint-drag(p.group, p.key, eff.index); }
                            keyframe-drag(o, n) => { root.move-midpoint(p.group, p.key, eff.index, o, n); }
                            keyframe-context-menu(is-point, frame, x, y) => {
                                root.kf-menu-visible = true;
                                root.kf-menu-is-add = !is-point;
                                root.kf-menu-frame = frame;
                                root.kf-menu-group = p.group;
                                root.kf-menu-key = p.key;
                                root.kf-menu-effect-index = eff.index;
                                root.kf-menu-x = x;
                                root.kf-menu-y = y;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.menu-visible: TouchArea {
        clicked => { root.menu-visible = false; }
    }

    if root.menu-visible: Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: 128px;
        height: 100px;
        background: #1e1e24;
        border-width: 1px;
        border-color: #303038;
        border-radius: 3px;

        VerticalLayout {
            MenuItem {
                label: "コピー";
                clicked => {
                    root.copy-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "貼り付け";
                clicked => {
                    root.paste-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "複製";
                clicked => {
                    root.duplicate-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "削除";
                clicked => {
                    root.remove-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }
        }
    }

    if root.kf-menu-visible: TouchArea {
        clicked => { root.kf-menu-visible = false; }
    }

    if root.kf-menu-visible: Rectangle {
        x: root.kf-menu-x;
        y: root.kf-menu-y;
        width: 128px;
        height: 26px;
        background: #1e1e24;
        border-width: 1px;
        border-color: #303038;
        border-radius: 3px;

        VerticalLayout {
            if root.kf-menu-is-add: MenuItem {
                label: "中間点を追加";
                clicked => {
                    root.add-midpoint(root.kf-menu-group, root.kf-menu-key,
                        root.kf-menu-effect-index, root.kf-menu-frame);
                    root.kf-menu-visible = false;
                }
            }

            if !root.kf-menu-is-add: MenuItem {
                label: "中間点を削除";
                clicked => {
                    root.remove-midpoint(root.kf-menu-group, root.kf-menu-key,
                        root.kf-menu-effect-index, root.kf-menu-frame);
                    root.kf-menu-visible = false;
                }
            }
        }
    }
}
