import { EffectRow, ParamRow } from "types.slint";

// AviQtl(ParamControl.qml)準拠: スライダー→開始値→LABEL→終了値→スライダーの左右対称構成。
// 両端のスライダー・数値ボックスは同一valueへ書き込む（可動域を左右へ拡張するための重複操作面）。
component PropertyRow inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> min: -1000;
    in property <float> max: 1000;
    in property <float> drag-sensitivity: 1;
    callback changed(float);
    callback commit-start();
    callback release();
    // ラベルクリックでイージングウィンドウを要求する。
    callback label-clicked();

    height: 22px;

    function clamp(v: float) -> float {
        return v < min ? min : v > max ? max : v;
    }

    function pointer-x-clamped(x: length, track-width: length) -> length {
        return x < 0px ? 0px : x > track-width ? track-width : x;
    }

    property <length> anchor-x: 0;
    property <length> anchor-y: 0;

    HorizontalLayout {
        spacing: 4px;

        slider-l := Rectangle {
            border-radius: 3px;
            background: #16161b;

            fill-l := Rectangle {
                x: 0;
                y: parent.height / 2 - 2px;
                width: (parent.width - handle-l.width) * ((root.clamp(root.value) - root.min) / (root.max - root.min)) + handle-l.width;
                height: 4px;
                border-radius: 2px;
                background: #3a6df0;
            }

            handle-l := Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: #dde3ee;
                y: parent.height / 2 - 5px;
                x: (parent.width - self.width) * ((root.clamp(root.value) - root.min) / (root.max - root.min));
            }

            TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.commit-start();
                            root.changed(root.clamp(root.min
                                + (root.pointer-x-clamped(self.mouse-x, self.width) / self.width) * (root.max - root.min)));
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.changed(root.clamp(root.min
                            + (root.pointer-x-clamped(self.mouse-x, self.width) / self.width) * (root.max - root.min)));
                    }
                }
            }
        }

        value-l := Rectangle {
            width: 56px;
            border-radius: 3px;
            background: drag-l.pressed ? #22222a : #16161b;
            border-width: 1px;
            border-color: #303038;

            input-l := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: 100%;
                text: root.value;
                color: #dde3ee;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: InputType.decimal;
                accepted => { root.changed(root.clamp(self.text.to-float())); }
            }

            drag-l := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.none : MouseCursor.default;
                clicked => { input-l.focus(); }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.anchor-x = self.mouse-x;
                            root.anchor-y = self.mouse-y;
                            root.commit-start();
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.changed(root.clamp(root.value
                            + (self.mouse-x - root.anchor-x) / 1px * root.drag-sensitivity
                            - (self.mouse-y - root.anchor-y) / 1px * root.drag-sensitivity));
                        root.anchor-x = self.mouse-x;
                        root.anchor-y = self.mouse-y;
                    }
                }
            }
        }

        label-cell := Rectangle {
            width: 74px;
            border-radius: 3px;
            background: label-touch.pressed ? #1c1c22 : label-touch.has-hover ? #262630 : #202026;

            Text {
                text: root.label;
                color: #b0b0ba;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }

            label-touch := TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.label-clicked();
                    }
                }
            }
        }

        value-r := Rectangle {
            width: 56px;
            border-radius: 3px;
            background: drag-r.pressed ? #22222a : #16161b;
            border-width: 1px;
            border-color: #303038;

            input-r := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: 100%;
                text: root.value;
                color: #dde3ee;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: InputType.decimal;
                accepted => { root.changed(root.clamp(self.text.to-float())); }
            }

            drag-r := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.none : MouseCursor.default;
                clicked => { input-r.focus(); }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.anchor-x = self.mouse-x;
                            root.anchor-y = self.mouse-y;
                            root.commit-start();
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.changed(root.clamp(root.value
                            + (self.mouse-x - root.anchor-x) / 1px * root.drag-sensitivity
                            - (self.mouse-y - root.anchor-y) / 1px * root.drag-sensitivity));
                        root.anchor-x = self.mouse-x;
                        root.anchor-y = self.mouse-y;
                    }
                }
            }
        }

        slider-r := Rectangle {
            border-radius: 3px;
            background: #16161b;

            fill-r := Rectangle {
                x: 0;
                y: parent.height / 2 - 2px;
                width: (parent.width - handle-r.width) * ((root.clamp(root.value) - root.min) / (root.max - root.min)) + handle-r.width;
                height: 4px;
                border-radius: 2px;
                background: #3a6df0;
            }

            handle-r := Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: #dde3ee;
                y: parent.height / 2 - 5px;
                x: (parent.width - self.width) * ((root.clamp(root.value) - root.min) / (root.max - root.min));
            }

            TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.commit-start();
                            root.changed(root.clamp(root.min
                                + (root.pointer-x-clamped(self.mouse-x, self.width) / self.width) * (root.max - root.min)));
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.changed(root.clamp(root.min
                            + (root.pointer-x-clamped(self.mouse-x, self.width) / self.width) * (root.max - root.min)));
                    }
                }
            }
        }
    }
}

// AviQtl準拠: 各パラメータ行の直下に置く中間点トラック。
// 空白部クリックでその位置のフレームへ中間点追加ウィンドウを要求し、
// 既存の中間点(◇)クリックでその点の編集ウィンドウを要求する。
component KeyframeTrack inherits Rectangle {
    in property <[int]> frames;
    in property <int> total-frames: 1;
    // 引数: クリック位置から算出したフレーム番号。
    callback point-clicked(int);

    height: 12px;
    border-radius: 2px;
    background: #131318;
    border-width: 1px;
    border-color: #24242c;

    function frame-at(x: length) -> int {
        return max(0, min(root.total-frames,
            (x / root.width * root.total-frames + 0.5)));
    }

    TouchArea {
        clicked => { root.point-clicked(root.frame-at(self.mouse-x)); }
    }

    for f in root.frames: Rectangle {
        x: (root.width - self.width) * (root.total-frames > 0 ? f / root.total-frames : 0);
        y: parent.height / 2 - 4px;
        width: 8px;
        height: 8px;

        Path {
            width: 100%;
            height: 100%;
            commands: "M 4 0 L 8 4 L 4 8 L 0 4 Z";
            fill: #3a6df0;
        }

        TouchArea {
            clicked => { root.point-clicked(f); }
        }
    }
}

component ToggleField inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    callback toggled();

    height: 22px;

    Text {
        text: label;
        color: #b0b0ba;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }

    Rectangle {
        x: parent.width - 36px;
        width: 36px;
        height: 18px;
        border-radius: 9px;
        background: checked ? #2a4db8 : #303038;

        Rectangle {
            x: checked ? parent.width - 16px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: #e8e8ee;
        }

        TouchArea {
            clicked() => { root.toggled(); }
        }
    }
}

component SectionHeader inherits Text {
    color: #55555e;
    font-size: 10px;
    font-weight: 700;
    height: 18px;
    vertical-alignment: center;
}

component MenuItem inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 24px;
    background: touch.has-hover ? #2a2a32 : transparent;

    Text {
        x: 8px;
        text: label;
        color: #c8c8d2;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// kind: 0=Float, 1=Bool, 2=Color, 3=Text
component ParamField inherits Rectangle {
    in property <ParamRow> data;
    in property <int> total-frames: 1;
    callback changed-float(float);
    callback changed-bool(bool);
    callback changed-text(string);
    callback commit();
    callback release();
    // 引数: 対象フレーム。-1の場合は呼び出し側が現在の再生位置を用いる。
    callback edit-keyframes(int);

    height: data.kind == 3 ? 44px : (data.kind == 0 || data.kind == 2) ? 34px : 22px;

    if data.kind == 0 || data.kind == 2: VerticalLayout {
        spacing: 2px;
        PropertyRow {
            label: data.label;
            value: data.value;
            min: data.kind == 2 ? 0 : data.min;
            max: data.kind == 2 ? 1 : data.max;
            changed(v) => { root.changed-float(v); }
            commit-start => { root.commit(); }
            release => { root.release(); }
            label-clicked => { root.edit-keyframes(-1); }
        }

        KeyframeTrack {
            frames: data.keyframe-frames;
            total-frames: root.total-frames;
            point-clicked(frame) => { root.edit-keyframes(frame); }
        }
    }

    if data.kind == 1: ToggleField {
        label: data.label;
        checked: data.value > 0.5;
        toggled => { root.changed-bool(data.value <= 0.5); }
    }

    if data.kind == 3: Rectangle {
        height: 44px;
        border-radius: 3px;
        background: #1e1e24;
        border-width: 1px;
        border-color: #303038;

        TextInput {
            x: 6px;
            y: 4px;
            width: parent.width - 12px;
            height: parent.height - 8px;
            text: data.text;
            color: #dde3ee;
            font-size: 11px;
            wrap: word-wrap;
            accepted => { root.changed-text(self.text); }
        }
    }
}

export component PropertiesWindow inherits Window {
    title: "NeoUtl - オブジェクト設定";
    preferred-width: 900px;
    preferred-height: 640px;
    background: #0e0e12;

    in-out property <int> object-id: -1;
    in-out property <float> stage-width: 1920;
    in-out property <float> stage-height: 1080;
    in-out property <int> total-frames: 300;

    in-out property <bool> has-transform: false;
    in-out property <bool> has-text: false;
    in-out property <bool> has-shape: false;
    in-out property <bool> has-audio: false;

    in-out property <[ParamRow]> object-params: [];
    in-out property <[EffectRow]> effects: [];
    in-out property <[ParamRow]> params: [];

    property <int> drag-source-index: -1;
    property <int> drag-target-index: -1;

    property <int> menu-index: -1;
    property <bool> menu-visible: false;
    property <length> menu-x: 0;
    property <length> menu-y: 0;

    property <bool> is-dragging-param: false;

    callback set-object-param(string, string, float);
    callback set-object-param-bool(string, string, bool);
    callback set-object-param-text(string, string, string);
    callback commit-object-param(string, string);
    callback set-effect-enabled(int, bool);
    callback remove-effect(int);
    callback set-param(int, string, float);
    callback set-param-bool(int, string, bool);
    callback commit-param(int, string);
    callback add-effect(string);
    callback move-effect(int, int);
    callback copy-effect(int);
    callback paste-effect(int);
    callback duplicate-effect(int);
    callback open-effect-add-dialog();
    // 引数: (group, key, effect-index, frame)。frame=-1は現在の再生位置を意味する。
    callback open-keyframe-editor(string, string, int, int);

    if object-id < 0: Text {
        text: "オブジェクトが選択されていません";
        color: #55555e;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    if object-id >= 0: HorizontalLayout {
        Rectangle {
            width: 180px;
            background: #131318;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;
                    SectionHeader {
                        text: "エフェクト";
                        vertical-alignment: center;
                        height: 100%;
                    }

                    Rectangle {
                        width: 44px;
                        height: 18px;
                        border-radius: 3px;
                        background: #1e1e24;
                        border-width: 1px;
                        border-color: #303038;
                        Text {
                            text: "追加";
                            color: #8a8a96;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        TouchArea {
                            clicked() => { root.open-effect-add-dialog(); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #24242c;
                }

                Flickable {
                    VerticalLayout {
                        spacing: 2px;

                        for eff[i] in root.effects: Rectangle {
                            height: 26px;
                            border-radius: 3px;
                            background: i == root.drag-target-index && root.drag-source-index >= 0
                                && root.drag-source-index != i
                                ? #2a4db8
                                : row-touch.has-hover ? #1c1c22 : #16161b;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 6px;

                                ToggleField {
                                    width: 26px;
                                    label: "";
                                    checked: eff.enabled;
                                    toggled => { root.set-effect-enabled(eff.index, !eff.enabled); }
                                }

                                Text {
                                    text: eff.name;
                                    color: #c8c8d2;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    height: 100%;
                                    overflow: elide;
                                }
                            }

                            row-touch := TouchArea {
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left) {
                                        if (event.kind == PointerEventKind.down) {
                                            root.drag-source-index = eff.index;
                                            root.drag-target-index = eff.index;
                                        }
                                        if (event.kind == PointerEventKind.up) {
                                            if (root.drag-source-index >= 0
                                                && root.drag-target-index >= 0
                                                && root.drag-target-index != root.drag-source-index) {
                                                root.move-effect(root.drag-source-index, root.drag-target-index);
                                            }
                                            root.drag-source-index = -1;
                                            root.drag-target-index = -1;
                                        }
                                    }
                                    if (event.button == PointerEventButton.right
                                        && event.kind == PointerEventKind.down) {
                                        root.menu-index = eff.index;
                                        root.menu-x = self.absolute-position.x + self.mouse-x;
                                        root.menu-y = self.absolute-position.y + self.mouse-y;
                                        root.menu-visible = true;
                                    }
                                }
                                moved => {
                                    if (self.pressed && root.drag-source-index >= 0) {
                                        root.drag-target-index = eff.index;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: #24242c;
        }

        Flickable {
            interactive: !root.is-dragging-param;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                for p[j] in root.object-params: Rectangle {
                    height: (j == 0 || p.group != root.object-params[j - 1].group ? 26px : 0px)
                        + (p.kind == 3 ? 44px : (p.kind == 0 || p.kind == 2) ? 34px : 22px);
                    clip: true;

                    VerticalLayout {
                        spacing: 4px;

                        if j == 0 || p.group != root.object-params[j - 1].group: SectionHeader {
                            text: p.group;
                        }

                        ParamField {
                            data: p;
                            total-frames: root.total-frames;
                            changed-float(v) => { root.set-object-param(p.group, p.key, v); }
                            changed-bool(v) => { root.set-object-param-bool(p.group, p.key, v); }
                            changed-text(v) => { root.set-object-param-text(p.group, p.key, v); }
                            commit => {
                                root.is-dragging-param = true;
                                root.commit-object-param(p.group, p.key);
                            }
                            release => { root.is-dragging-param = false; }
                            edit-keyframes(frame) => { root.open-keyframe-editor(p.group, p.key, -1, frame); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #24242c;
                }

                for eff[i] in root.effects: VerticalLayout {
                    spacing: 2px;

                    SectionHeader {
                        text: eff.name;
                    }

                    for p[j] in root.params: Rectangle {
                        height: p.effect-index != eff.index ? 0px
                            : p.kind == 3 ? 44px : (p.kind == 0 || p.kind == 2) ? 34px : 22px;
                        clip: true;

                        if p.effect-index == eff.index: ParamField {
                            data: p;
                            total-frames: root.total-frames;
                            changed-float(v) => { root.set-param(eff.index, p.key, v); }
                            changed-bool(v) => { root.set-param-bool(eff.index, p.key, v); }
                            commit => {
                                root.is-dragging-param = true;
                                root.commit-param(eff.index, p.key);
                            }
                            release => { root.is-dragging-param = false; }
                            edit-keyframes(frame) => { root.open-keyframe-editor(p.group, p.key, eff.index, frame); }
                        }
                    }
                }
            }
        }
    }

    if root.menu-visible: TouchArea {
        clicked => { root.menu-visible = false; }
    }

    if root.menu-visible: Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: 128px;
        height: 100px;
        background: #1e1e24;
        border-width: 1px;
        border-color: #303038;
        border-radius: 3px;

        VerticalLayout {
            MenuItem {
                label: "コピー";
                clicked => {
                    root.copy-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "貼り付け";
                clicked => {
                    root.paste-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "複製";
                clicked => {
                    root.duplicate-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "削除";
                clicked => {
                    root.remove-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }
        }
    }
}
