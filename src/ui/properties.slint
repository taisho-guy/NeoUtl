import { EffectRow, ParamRow } from "types.slint";

component PropertyRow inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> min: -1000;
    in property <float> max: 1000;
    in property <float> drag-sensitivity: 1;
    callback changed(float);
    // ドラッグ操作1回（press〜release）の先頭でのみ発火する。
    // Undo履歴のスナップショット確定はこの1回のみに限定する。
    callback commit-start();
    callback release();

    height: 22px;

    function clamp(v: float) -> float {
        return v < min ? min : v > max ? max : v;
    }

    // TouchArea内のmouse-xをスライダー可動域[0, track-width]へ丸める。
    // Slintに組み込みのグローバルmin/max関数は存在しないため四項式で実装する。
    function pointer-x-clamped(x: length, track-width: length) -> length {
        return x < 0px ? 0px : x > track-width ? track-width : x;
    }

    // ドラッグ中の直前座標。press開始はpointer-eventのdownで確定するため
    // moved側での1フレーム目判定は不要。
    property <length> anchor-x: 0;
    property <length> anchor-y: 0;

    HorizontalLayout {
        spacing: 4px;

        // スライダー本体（自作）。std-widgets.Sliderはpress開始の遷移を
        // 外部へ公開しないため、コミット単位検知に必要な自前TouchAreaへ置換する。
        Rectangle {
            border-radius: 3px;
            background: #16161b;

            track-fill := Rectangle {
                x: 0;
                y: parent.height / 2 - 2px;
                width: (parent.width - handle.width) * ((root.clamp(root.value) - root.min) / (root.max - root.min)) + handle.width;
                height: 4px;
                border-radius: 2px;
                background: #3a6df0;
            }

            handle := Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: #dde3ee;
                y: parent.height / 2 - 5px;
                x: (parent.width - self.width) * ((root.clamp(root.value) - root.min) / (root.max - root.min));
            }

            slider-touch := TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.commit-start();
                            root.changed(root.clamp(root.min
                                + (root.pointer-x-clamped(self.mouse-x, self.width) / self.width) * (root.max - root.min)));
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.changed(root.clamp(root.min
                            + (root.pointer-x-clamped(self.mouse-x, self.width) / self.width) * (root.max - root.min)));
                    }
                }
            }
        }

        Rectangle {
            width: 64px;
            border-radius: 3px;
            background: drag-area.pressed ? #22222a : #16161b;
            border-width: 1px;
            border-color: #303038;

            input := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: 100%;
                text: root.value;
                color: #dde3ee;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                input-type: InputType.decimal;
                accepted => { root.changed(root.clamp(self.text.to-float())); }
            }

            // ドラッグ量=移動量そのもの。画面端到達でそれ以上は追従不能
            // （Slintにポインタロック/warp APIが無いための既知の制約）。
            drag-area := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.none : MouseCursor.default;
                clicked => { input.focus(); }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            root.anchor-x = self.mouse-x;
                            root.anchor-y = self.mouse-y;
                            root.commit-start();
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.release();
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.changed(root.clamp(root.value
                            + (self.mouse-x - root.anchor-x) / 1px * root.drag-sensitivity
                            - (self.mouse-y - root.anchor-y) / 1px * root.drag-sensitivity));
                        root.anchor-x = self.mouse-x;
                        root.anchor-y = self.mouse-y;
                    }
                }
            }
        }

        // AviQtl(ParamControl.qml)のトラックバー行はラベルを中央のボタンとして配置し、
        // 数値・スライダー操作を左側（主操作領域）へ寄せる。NeoUtlも同じ視覚的重み付けへ揃える。
        Rectangle {
            width: 74px;
            background: #202026;
            Text {
                text: label;
                color: #b0b0ba;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }
}

component ToggleField inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    callback toggled();

    height: 22px;

    Text {
        text: label;
        color: #b0b0ba;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }

    Rectangle {
        x: parent.width - 36px;
        width: 36px;
        height: 18px;
        border-radius: 9px;
        background: checked ? #2a4db8 : #303038;

        Rectangle {
            x: checked ? parent.width - 16px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: #e8e8ee;
        }

        TouchArea {
            clicked() => { root.toggled(); }
        }
    }
}

component SectionHeader inherits Text {
    color: #55555e;
    font-size: 10px;
    font-weight: 700;
}

component MenuItem inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 24px;
    background: touch.has-hover ? #2a2a32 : transparent;

    Text {
        x: 8px;
        text: label;
        color: #c8c8d2;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ParamRow.kindに応じた描画を一本化する標準コンポーネント。
// object-params/エフェクトパラメータの両呼び出し元がこれのみを使う。
// kind: 0=Float(スライダー+数値ボックス), 1=Bool(トグル), 2=Color(0..1スライダー)。
// 新規kindの追加時はここに分岐を1件足すだけで全呼び出し元に反映される。
component ParamField inherits Rectangle {
    in property <ParamRow> data;
    callback changed-float(float);
    callback changed-bool(bool);
    callback changed-text(string);
    // ドラッグ系操作（kind 0/2）1回の先頭・末尾のみ発火する。
    callback commit();
    callback release();

    height: data.kind == 3 ? 44px : 22px;

    if data.kind == 0: PropertyRow {
        label: data.label;
        value: data.value;
        min: data.min;
        max: data.max;
        changed(v) => { root.changed-float(v); }
        commit-start => { root.commit(); }
        release => { root.release(); }
    }

    if data.kind == 1: ToggleField {
        label: data.label;
        checked: data.value > 0.5;
        toggled => { root.changed-bool(data.value <= 0.5); }
    }

    if data.kind == 2: PropertyRow {
        label: data.label;
        value: data.value;
        min: 0;
        max: 1;
        changed(v) => { root.changed-float(v); }
        commit-start => { root.commit(); }
        release => { root.release(); }
    }

    if data.kind == 3: Rectangle {
        height: 44px;
        border-radius: 3px;
        background: #1e1e24;
        border-width: 1px;
        border-color: #303038;

        TextInput {
            x: 6px;
            y: 4px;
            width: parent.width - 12px;
            height: parent.height - 8px;
            text: data.text;
            color: #dde3ee;
            font-size: 11px;
            wrap: word-wrap;
            accepted => { root.changed-text(self.text); }
        }
    }
}

export component PropertiesWindow inherits Window {
    title: "NeoUtl - オブジェクト設定";
    preferred-width: 780px;
    preferred-height: 640px;
    background: #0e0e12;

    in-out property <int> object-id: -1;
    in-out property <float> stage-width: 1920;
    in-out property <float> stage-height: 1080;

    in-out property <bool> has-transform: false;
    in-out property <bool> has-text: false;
    in-out property <bool> has-shape: false;
    in-out property <bool> has-audio: false;

    // Transform/Text/Shape/Audioの数値・真偽値・文字列項目はすべてこの一本のリストに統一する。
    // 並び順・ラベル・レンジ・種別はRust側object_schema.rsのみが決定し、ここでは
    // kind別（0=Float,1=Bool,2=Color,3=Text）の描画分岐のみを行う（型別ハードコード撤廃）。
    in-out property <[ParamRow]> object-params: [];

    in-out property <[EffectRow]> effects: [];
    in-out property <[ParamRow]> params: [];

    // サイドバー: ドラッグ並べ替え用の一時状態。press中のみ非-1。
    property <int> drag-source-index: -1;
    property <int> drag-target-index: -1;

    // サイドバー: 右クリックメニューの一時状態。
    property <int> menu-index: -1;
    property <bool> menu-visible: false;
    property <length> menu-x: 0;
    property <length> menu-y: 0;

    // パラメータのスライダー/ドラッグボックス操作中フラグ。trueの間は右側Flickableの
    // スクロールを禁止し、操作中に表示が上下へ動いてポインタがスライダーから
    // 外れる現象を除去する。
    property <bool> is-dragging-param: false;

    callback set-object-param(string, string, float);
    callback set-object-param-bool(string, string, bool);
    callback set-object-param-text(string, string, string);
    callback commit-object-param(string, string);
    callback set-effect-enabled(int, bool);
    callback remove-effect(int);
    callback set-param(int, string, float);
    callback set-param-bool(int, string, bool);
    callback commit-param(int, string);
    callback add-effect(string);
    callback move-effect(int, int);
    callback copy-effect(int);
    callback paste-effect(int);
    callback duplicate-effect(int);
    // 一覧・検索・ソートはEffectAddDialog（独立ウィンドウ）側で完結する。
    // このウィンドウはダイアログの起動要求のみを発行する。
    callback open-effect-add-dialog();

    if object-id < 0: Text {
        text: "オブジェクトが選択されていません";
        color: #55555e;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    if object-id >= 0: HorizontalLayout {
        // --- 左サイドバー: エフェクト一覧（有効無効・ドラッグ並べ替え・右クリック操作） ---
        Rectangle {
            width: 180px;
            background: #131318;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;
                    SectionHeader {
                        text: "エフェクト";
                        vertical-alignment: center;
                        height: 100%;
                    }

                    Rectangle {
                        width: 44px;
                        height: 18px;
                        border-radius: 3px;
                        background: #1e1e24;
                        border-width: 1px;
                        border-color: #303038;
                        Text {
                            text: "追加";
                            color: #8a8a96;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        TouchArea {
                            clicked() => { root.open-effect-add-dialog(); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #24242c;
                }

                Flickable {
                    VerticalLayout {
                        spacing: 2px;

                        for eff[i] in root.effects: Rectangle {
                            height: 26px;
                            border-radius: 3px;
                            background: i == root.drag-target-index && root.drag-source-index >= 0
                                && root.drag-source-index != i
                                ? #2a4db8
                                : row-touch.has-hover ? #1c1c22 : #16161b;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 6px;

                                ToggleField {
                                    width: 26px;
                                    label: "";
                                    checked: eff.enabled;
                                    toggled => { root.set-effect-enabled(eff.index, !eff.enabled); }
                                }

                                Text {
                                    text: eff.name;
                                    color: #c8c8d2;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    height: 100%;
                                    overflow: elide;
                                }
                            }

                            row-touch := TouchArea {
                                // 左ボタン押下でドラッグ開始。press継続中の行を随時target登録し、
                                // release時にsource!=targetならmove-effectを一度だけ発行する。
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left) {
                                        if (event.kind == PointerEventKind.down) {
                                            root.drag-source-index = eff.index;
                                            root.drag-target-index = eff.index;
                                        }
                                        if (event.kind == PointerEventKind.up) {
                                            if (root.drag-source-index >= 0
                                                && root.drag-target-index >= 0
                                                && root.drag-target-index != root.drag-source-index) {
                                                root.move-effect(root.drag-source-index, root.drag-target-index);
                                            }
                                            root.drag-source-index = -1;
                                            root.drag-target-index = -1;
                                        }
                                    }
                                    if (event.button == PointerEventButton.right
                                        && event.kind == PointerEventKind.down) {
                                        root.menu-index = eff.index;
                                        root.menu-x = self.absolute-position.x + self.mouse-x;
                                        root.menu-y = self.absolute-position.y + self.mouse-y;
                                        root.menu-visible = true;
                                    }
                                }
                                moved => {
                                    if (self.pressed && root.drag-source-index >= 0) {
                                        root.drag-target-index = eff.index;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: #24242c;
        }

        // --- 右側: オブジェクト直下パラメータ + 選択中エフェクトのパラメータ ---
        Flickable {
            // is-dragging-param中はスクロール操作を禁止する。
            // スライダー/ドラッグボックス操作中に表示位置が動いてポインタが
            // 操作対象から外れる現象の根絶。
            interactive: !root.is-dragging-param;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                for p[j] in root.object-params: VerticalLayout {
                    spacing: 4px;

                    if j == 0 || p.group != root.object-params[j - 1].group: VerticalLayout {
                        spacing: 4px;
                        Rectangle {
                            height: 1px;
                            background: #24242c;
                        }

                        SectionHeader {
                            text: p.group;
                        }
                    }

                    if p.kind == 0: ParamField {
                        data: p;
                        changed-float(v) => { root.set-object-param(p.group, p.key, v); }
                        commit => {
                            root.is-dragging-param = true;
                            root.commit-object-param(p.group, p.key);
                        }
                        release => { root.is-dragging-param = false; }
                    }

                    if p.kind == 1: ParamField {
                        data: p;
                        changed-bool(v) => { root.set-object-param-bool(p.group, p.key, v); }
                    }

                    if p.kind == 2: ParamField {
                        data: p;
                        changed-float(v) => { root.set-object-param(p.group, p.key, v); }
                        commit => {
                            root.is-dragging-param = true;
                            root.commit-object-param(p.group, p.key);
                        }
                        release => { root.is-dragging-param = false; }
                    }

                    if p.kind == 3: ParamField {
                        data: p;
                        changed-text(v) => { root.set-object-param-text(p.group, p.key, v); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #24242c;
                }

                for eff[i] in root.effects: VerticalLayout {
                    spacing: 2px;

                    SectionHeader {
                        text: eff.name;
                    }

                    // paramsはParamRow.kindに応じ、ParamFieldが標準描画へ振り分ける。
                    for p[j] in root.params: Rectangle {
                        height: p.effect-index == eff.index ? 22px : 0px;
                        clip: true;

                        if p.effect-index == eff.index: ParamField {
                            data: p;
                            changed-float(v) => { root.set-param(eff.index, p.key, v); }
                            changed-bool(v) => { root.set-param-bool(eff.index, p.key, v); }
                            commit => {
                                root.is-dragging-param = true;
                                root.commit-param(eff.index, p.key);
                            }
                            release => { root.is-dragging-param = false; }
                        }
                    }
                }
            }
        }
    }

    // --- 右クリックコンテキストメニュー: コピー/貼り付け/複製/削除 ---
    // 背後の透明TouchAreaは全面を覆い、メニュー外クリックで閉じる役目のみを持つ。
    if root.menu-visible: TouchArea {
        clicked => { root.menu-visible = false; }
    }

    if root.menu-visible: Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: 128px;
        height: 100px;
        background: #1e1e24;
        border-width: 1px;
        border-color: #303038;
        border-radius: 3px;

        VerticalLayout {
            MenuItem {
                label: "コピー";
                clicked => {
                    root.copy-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "貼り付け";
                clicked => {
                    root.paste-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "複製";
                clicked => {
                    root.duplicate-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }

            MenuItem {
                label: "削除";
                clicked => {
                    root.remove-effect(root.menu-index);
                    root.menu-visible = false;
                }
            }
        }
    }
}
