import { TimelineObject } from "../types.slint";

export component ClipItem inherits Rectangle {
    in property <TimelineObject> obj;
    in property <float> scale: 1.0;
    in property <length> layer-height: 24px;
    in property <bool> locked: false;
    in property <bool> ripple-mode: false;

    callback clicked(int);
    callback moved(int /* id */, int /* new-start-frame */, int /* new-layer */, bool /* ripple */);
    callback resized(int /* id */, int /* new-start-frame */, int /* new-end-frame */, bool /* ripple */);
    callback context-requested(int /* id */, length /* x */, length /* y */);
    callback keyframe-moved(int /* id */, int /* old-frame */, int /* new-frame */);
    // クリップ上の境界点を（ドラッグ移動ではなく）クリックした際に発火する。
    // 区間イージング編集パネルをその点から始まる区間へ切り替えて開く。
    callback keyframe-clicked(int /* id */, int /* frame */);

    property <[color]> kind-palette: [#2a4db8, #256e3c, #6a2db8, #b8862a, #2ab8a8, #b82a5f];
    property <color> base-color: !obj.kind-known ? #5a5a5a : root.kind-palette[mod(obj.kind, root.kind-palette.length)];
    property <color> effective-color: obj.selected ? base-color.brighter(40%) : base-color;

    property <bool> dragging: false;
    property <bool> resizing-left: false;
    property <bool> resizing-right: false;
    property <length> press-abs-x: 0px;
    property <length> press-abs-y: 0px;
    property <int> drag-start-frame: 0;
    property <int> drag-start-layer: 0;
    property <int> drag-duration: 0;
    property <int> preview-start: obj.start-frame;
    property <int> preview-layer: obj.layer;
    property <int> preview-end: obj.end-frame;

    // 操作完了時、この操作(moved/resized)で確定した値と一致するまでobjの実値が
    // 届いていないため、reset-preview()をここでは呼ばない。obj自体が更新された
    // これにより「操作完了直後に一瞬旧位置へ戻ってから正しい位置へ再度動く」
    // ティアリングを排除する（左端リサイズはx/widthが同時に変わるため、この
    // ティアリングが「戻る＝伸ばせない」ように誤認されていた）。
    changed obj => {
        if (!root.dragging) {
            root.preview-layer = obj.layer;
        }
        if (!root.dragging && !root.resizing-left) {
            root.preview-start = obj.start-frame;
        }
        if (!root.dragging && !root.resizing-right) {
            root.preview-end = obj.end-frame;
        }
    }

    function reset-preview() {
        root.preview-start = obj.start-frame;
        root.preview-end = obj.end-frame;
        root.preview-layer = obj.layer;
    }

    x: root.preview-start * root.scale * 1px;
    y: root.preview-layer * root.layer-height + root.layer-height * 0.1;
    width: max(4px, (root.preview-end - root.preview-start) * root.scale * 1px);
    height: root.layer-height * 0.8;

    background: @linear-gradient(90deg, root.effective-color.darker(50%) 0%, root.effective-color 100%);
    border-width: obj.selected ? 2px : 1px;
    border-color: obj.selected ? #ffffff : base-color.darker(30%);
    border-radius: 3px;
    clip: true;

    if obj.has-waveform: Image {
        x: 3px + (obj.waveform-origin-frame - root.preview-start) * root.scale * 1px;
        y: 3px;
        width: max(1px, obj.waveform-duration-frames * root.scale * 1px);
        height: max(1px, parent.height - 6px);
        source: obj.waveform;
        opacity: obj.selected ? 0.9 : 0.65;
    }

    Text {
        text: obj.label;
        color: white;
        font-size: 10px;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 12px;
        x: 6px;
    }

    // プロパティパネルで選択中のパラメータの中間点位置のみ表示する。
    // 位置決定はRust側(timeline::refresh_keyframe_markers)が担い、ここでは
    // 正規化済みフレーム値をピクセル座標へ写像する描画と、水平ドラッグによる
    // フレーム移動操作（AviQtl EffectModel::moveKeyframe相当）のみを行う。
    // 値・補間種別の変更は行わない（キーフレームエディタ側の責務）。
    for f in obj.keyframe-frames: Rectangle {
        property <bool> dragging: false;
        property <int> drag-delta: 0;
        property <length> press-abs-x: 0px;

        width: 8px;
        height: 8px;
        x: (f - obj.start-frame + (self.dragging ? self.drag-delta : 0)) * parent.width / max(1, obj.end-frame - obj.start-frame) - 4px;
        y: parent.height / 2 - 4px;

        Path {
            x: 1px;
            y: 1px;
            width: 6px;
            height: 6px;
            commands: "M 3 0 L 6 3 L 3 6 L 0 3 Z";
            fill: #ffd23a;
            stroke: #8a6a10;
            stroke-width: 1px;
        }

        marker-touch := TouchArea {
            mouse-cursor: root.locked ? MouseCursor.not-allowed : MouseCursor.col-resize;
            property <length> cur-abs-x: self.absolute-position.x + self.mouse-x;

            pointer-event(e) => {
                if (root.locked) { return; }
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    parent.dragging = true;
                    parent.press-abs-x = self.absolute-position.x + self.pressed-x;
                    parent.drag-delta = 0;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    if (parent.dragging) {
                        parent.dragging = false;
                        if (parent.drag-delta != 0) {
                            root.keyframe-moved(obj.id, f, max(obj.start-frame, min(obj.end-frame, f + parent.drag-delta)));
                        } else {
                            root.keyframe-clicked(obj.id, f);
                        }
                    }
                }
            }
            moved() => {
                if (!parent.dragging) { return; }
                parent.drag-delta = floor((self.cur-abs-x - parent.press-abs-x) / root.scale / 1px);
            }
        }
    }

    body-touch := TouchArea {
        mouse-cursor: root.locked ? MouseCursor.not-allowed : (root.dragging ? MouseCursor.grabbing : MouseCursor.grab);
        property <length> cur-abs-x: self.absolute-position.x + self.mouse-x;
        property <length> cur-abs-y: self.absolute-position.y + self.mouse-y;

        pointer-event(e) => {
            if (root.locked) { return; }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                // clicked()呼び出し先が選択状態更新のためモデルを再構築する経路を持つ場合、
                // 本要素自体が再生成され得る。呼び出し後に行うローカル状態書き込みは
                // 再生成後の別インスタンスに反映されず失われるため、外部コールバック起動前に
                // ドラッグ開始状態を確定させる。
                root.reset-preview();
                root.dragging = true;
                root.press-abs-x = self.absolute-position.x + self.pressed-x;
                root.press-abs-y = self.absolute-position.y + self.pressed-y;
                root.drag-start-frame = obj.start-frame;
                root.drag-start-layer = obj.layer;
                root.drag-duration = obj.end-frame - obj.start-frame;
                root.clicked(obj.id);
            }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.clicked(obj.id);
                root.context-requested(obj.id, self.absolute-position.x + self.pressed-x, self.absolute-position.y + self.pressed-y);
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.dragging = false;
                    root.moved(obj.id, root.preview-start, root.preview-layer, root.ripple-mode);
                }
            }
        }

        moved() => {
            if (!root.dragging) { return; }
            root.preview-start = max(0, root.drag-start-frame + floor((self.cur-abs-x - root.press-abs-x) / root.scale / 1px));
            root.preview-end = root.preview-start + root.drag-duration;
            root.preview-layer = max(0, root.drag-start-layer + floor((self.cur-abs-y - root.press-abs-y) / root.layer-height));
        }
    }

    left-handle := TouchArea {
        width: 6px;
        height: parent.height;
        mouse-cursor: root.locked ? MouseCursor.not-allowed : MouseCursor.col-resize;
        property <int> start-frame: 0;
        property <int> end-frame: 0;
        property <length> press-abs-x: 0px;
        property <length> cur-abs-x: self.absolute-position.x + self.mouse-x;

        pointer-event(e) => {
            if (root.locked) { return; }
            if (e.kind == PointerEventKind.down) {
                root.reset-preview();
                root.resizing-left = true;
                self.press-abs-x = self.absolute-position.x + self.pressed-x;
                self.start-frame = obj.start-frame;
                self.end-frame = obj.end-frame;
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.resizing-left) {
                    root.resizing-left = false;
                    root.resized(obj.id, root.preview-start, root.preview-end, false);
                }
            }
        }
        moved() => {
            if (!root.resizing-left) { return; }
            root.preview-start = min(self.end-frame - 1, max(0, self.start-frame + floor((self.cur-abs-x - self.press-abs-x) / root.scale / 1px)));
        }
    }

    right-handle := TouchArea {
        x: parent.width - 6px;
        width: 6px;
        height: parent.height;
        mouse-cursor: root.locked ? MouseCursor.not-allowed : MouseCursor.col-resize;
        property <int> start-frame: 0;
        property <int> end-frame: 0;
        property <length> press-abs-x: 0px;
        property <length> cur-abs-x: self.absolute-position.x + self.mouse-x;

        pointer-event(e) => {
            if (root.locked) { return; }
            if (e.kind == PointerEventKind.down) {
                root.reset-preview();
                root.resizing-right = true;
                self.press-abs-x = self.absolute-position.x + self.pressed-x;
                self.start-frame = obj.start-frame;
                self.end-frame = obj.end-frame;
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.resizing-right) {
                    root.resizing-right = false;
                    root.resized(obj.id, root.preview-start, root.preview-end, root.ripple-mode);
                }
            }
        }
        moved() => {
            if (!root.resizing-right) { return; }
            root.preview-end = max(self.start-frame + 1, self.end-frame + floor((self.cur-abs-x - self.press-abs-x) / root.scale / 1px));
        }
    }
}
