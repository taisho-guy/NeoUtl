import { IconDisplay, IconSet } from "@lucide";
import { IconButton, KeyUtil, IconLookup } from "common.slint";
import {
    TimelineObject,
    LayerState,
    SceneTabItem,
    ObjectKindItem,
    ContextMenuItem,
} from "types.slint";
import { Ruler } from "timeline/ruler.slint";
import { LayerHeader } from "timeline/layer-header.slint";
import { TimelineView } from "timeline/timeline-view.slint";

export component TimelineWindow inherits Window {
    title: "NeoUtl - 拡張編集";
    preferred-width: 720px;
    preferred-height: 540px;
    min-width: 320px;
    min-height: 240px;
    max-width: 100000px;
    max-height: 100000px;
    background: #0e0e12;

    in-out property <int> current-frame: 0;
    in-out property <int> total-frames: 300;
    in-out property <int> layer-count: 128;
    in-out property <float> zoom-scale: 1.0;
    in-out property <int> selected-layer: 0;
    in-out property <[TimelineObject]> objects: [];
    in-out property <[LayerState]> layer-states: [];
    in-out property <[SceneTabItem]> scene-tabs: [];
    in-out property <[ObjectKindItem]> available-kinds: [];

    callback seek-timeline(int);
    callback add-object-at(int /* frame */, int /* layer */, int /* kind */);
    callback delete-object(int);
    callback select-object(int);
    callback move-object(int /* id */, int /* start-frame */, int /* layer */, bool /* ripple */);
    callback resize-object(int /* id */, int /* start-frame */, int /* end-frame */, bool /* ripple */);
    callback split-object-at(int /* id */, int /* frame */);
    callback keyframe-moved(int /* id */, int /* old-frame */, int /* new-frame */);
    // クリップ上の境界点クリックで区間イージング編集パネルを開く（値・フレームは指定しない）。
    callback keyframe-clicked(int /* id */, int /* frame */);
    callback range-select(int /* start-frame */, int /* end-frame */, int /* start-layer */, int /* end-layer */);
    callback set-zoom(float);
    callback toggle-layer-visible(int);
    callback toggle-layer-locked(int);
    callback switch-scene-tab(int);
    callback open-scene-settings-create();
    callback open-scene-settings-edit(int);
    callback close-scene-tab(int);
    callback undo-requested();
    callback redo-requested();
    callback duplicate-requested(int /* hit-id */);
    callback cut-requested(int /* hit-id */);
    callback copy-requested(int /* hit-id */);
    callback paste-requested();
    callback raw-key-event(bool /* ctrl */, bool /* shift */, bool /* alt */, string /* key */);

    property <int> header-width: 60;
    property <int> layer-height: 24;
    // ズーム倍率とグリッド刻み幅の対応表。ruler/grid双方が本プロパティのみを参照する。
    property <int> frame-interval: root.zoom-scale > 3.0 ? 10 : root.zoom-scale > 1.0 ? 30 : root.zoom-scale > 0.3 ? 60 : 300;

    property <length> scroll-x: 0px;
    property <length> scroll-y: 0px;
    property <length> content-width: root.total-frames * root.zoom-scale * 1px;
    property <length> content-height: root.layer-count * root.layer-height * 1px;

    function clamp-zoom(s: float) -> float {
        return max(0.1, min(10.0, s));
    }

    in-out property <bool> ripple-mode: false;

    property <bool> show-context-menu: false;
    in-out property <int> menu-target-id: -1;
    property <int> menu-frame: 0;
    property <int> menu-layer: 0;
    property <length> menu-x: 0px;
    property <length> menu-y: 0px;
    // 項目集合はRust側(timeline.rs::build_context_menu)がon-context-menu-requested内で
    // set-menu-itemsする唯一の生成元。将来の項目追加はRust側1関数の変更のみで完結し、
    // 本ファイルはaction値による分岐描画のみを担う。
    in-out property <[ContextMenuItem]> menu-items: [];
    callback context-menu-requested(int /* hit-id */, int /* frame */, int /* layer */);

    key-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.raw-key-event(event.modifiers.control, event.modifiers.shift, event.modifiers.alt, KeyUtil.normalize-key(event));
            accept
        }

        VerticalLayout {
        width: 100%;
        height: 100%;
        Rectangle {
            height: 28px;
            background: #16161c;

            HorizontalLayout {
                padding: 4px;
                spacing: 2px;

                for tab[i] in root.scene-tabs: Rectangle {
                    width: 120px;
                    border-radius: 3px;
                    background: tab.active ? #2a2a32 : (st.has-hover ? #202026 : transparent);
                    border-width: tab.active ? 1px : 0px;
                    border-color: #3a5fd9;

                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 4px;

                        Text {
                            text: tab.name;
                            color: tab.active ? #ffffff : #999aa4;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        IconButton {
                            icon: IconSet.Settings;
                            icon-size: 11px;
                            clicked() => { root.open-scene-settings-edit(tab.id); }
                        }

                        IconButton {
                            icon: IconSet.X;
                            icon-size: 11px;
                            clicked() => { root.close-scene-tab(tab.id); }
                        }
                    }

                    st := TouchArea {
                        clicked() => { root.switch-scene-tab(tab.id); }
                    }
                }

                IconButton {
                    icon: IconSet.Plus;
                    clicked() => { root.open-scene-settings-create(); }
                }
            }
        }

        Ruler {
            width: 100%;
            scale: root.zoom-scale;
            frame-interval: root.frame-interval;
            scroll-x: root.scroll-x;
            fps: 30;
            current-frame: root.current-frame;
            total-frames: root.total-frames;
            header-width: root.header-width * 1px;
            scrub(frame) => { root.seek-timeline(frame); }
            zoom(new-scale, anchor-frame) => {
                root.scroll-x = max(0px, root.scroll-x + (root.clamp-zoom(new-scale) - root.zoom-scale) * anchor-frame * 1px);
                root.zoom-scale = root.clamp-zoom(new-scale);
                root.set-zoom(root.zoom-scale);
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            layer-header := LayerHeader {
                header-width: root.header-width * 1px;
                layer-height: root.layer-height * 1px;
                layer-count: root.layer-count;
                scroll-y: root.scroll-y;
                selected-layer: root.selected-layer;
                layer-states: root.layer-states;
                toggle-visible(layer) => { root.toggle-layer-visible(layer); }
                toggle-locked(layer) => { root.toggle-layer-locked(layer); }
                select-layer(layer) => { root.selected-layer = layer; }
                scroll-requested(dy) => {
                    root.scroll-y = max(0px, min(root.scroll-y - dy, max(0px, root.content-height - max(1px, layer-header.height))));
                }
            }

            view := TimelineView {
                horizontal-stretch: 1;
                scale: root.zoom-scale;
                frame-interval: root.frame-interval;
                total-frames: root.total-frames;
                layer-count: root.layer-count;
                layer-height: root.layer-height * 1px;
                current-frame: root.current-frame;
                objects: root.objects;
                layer-states: root.layer-states;
                scroll-x: root.scroll-x;
                scroll-y: root.scroll-y;
                ripple-mode: root.ripple-mode;

                seek(frame) => { root.seek-timeline(frame); }
                select-object(id) => { root.select-object(id); }
                range-select(sf, ef, sl, el) => { root.range-select(sf, ef, sl, el); }
                move-object(id, start, layer, ripple) => { root.move-object(id, start, layer, ripple); }
                resize-object(id, start, end, ripple) => { root.resize-object(id, start, end, ripple); }
                keyframe-moved(id, old-frame, new-frame) => { root.keyframe-moved(id, old-frame, new-frame); }
                keyframe-clicked(id, frame) => { root.keyframe-clicked(id, frame); }
                scroll-requested(dx) => {
                    root.scroll-x = max(0px, min(root.scroll-x - dx, max(0px, root.content-width - max(1px, view.width))));
                }
                context-menu(x, y, frame, layer, hit-id) => {
                    root.menu-frame = frame;
                    root.menu-layer = layer;
                    root.menu-target-id = hit-id;
                    root.menu-x = x;
                    root.menu-y = y + 4px;
                    root.show-context-menu = true;
                    root.context-menu-requested(hit-id, frame, layer);
                }
            }
        }
    }
    }

    // メニュー項目集合はRust側(timeline.rs::build_context_menu)のみが生成する。
    // （区切り線=action4はクリック不可・背景色のみ変えた薄い罫線として描画）。
    if root.show-context-menu: TouchArea {
        width: 100%;
        height: 100%;
        clicked() => { root.show-context-menu = false; }
    }

    if (root.show-context-menu): Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: 190px;
        height: root.menu-items.length * 30px + 8px;
        background: #252528;
        border-width: 1px;
        border-color: #48484e;
        border-radius: 5px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000088;
        drop-shadow-offset-x: 2px;
        drop-shadow-offset-y: 2px;

        VerticalLayout {
            padding: 4px;
            spacing: 1px;

            for item[i] in root.menu-items: Rectangle {
                height: item.action == 4 ? 9px : 30px;
                border-radius: 3px;
                background: item.action == 4 ? transparent : (item-touch.has-hover && item.enabled ? #303038 : transparent);

                if (item.action == 4): Rectangle {
                    y: 4px;
                    height: 1px;
                    width: parent.width;
                    background: #3c3c42;
                }

                if (item.action != 4): HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;

                    IconDisplay {
                        y: 8px;
                        icon: IconLookup.icon-for(item.icon);
                        stroke: !item.enabled ? #6a6a6e : (item.action == 1 ? #ff8888 : item.action == 0 ? #88c4ff : item.action == 3 ? #ffd23a : (item.action == 5 || item.action == 6) ? #a0a0a8 : (item.action == 7 || item.action == 8 || item.action == 9 || item.action == 10) ? #a0ffb0 : #8aabff.mix(#c0a0ff, mod(max(item.kind, 0), 5) / 4.0));
                        size: 14px;
                        vertical-stretch: 0;
                    }

                    Text {
                        text: item.label;
                        color: !item.enabled ? #6a6a6e : (item.action == 1 ? #ff8888 : item.action == 0 ? #88c4ff : item.action == 3 ? #ffd23a : (item.action == 5 || item.action == 6) ? #a0a0a8 : (item.action == 7 || item.action == 8 || item.action == 9 || item.action == 10) ? #a0ffb0 : #8aabff.mix(#c0a0ff, mod(max(item.kind, 0), 5) / 4.0));
                        font-size: 12px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                item-touch := TouchArea {
                    enabled: item.action != 4 && item.enabled;
                    clicked() => {
                        if (item.action == 0) { root.split-object-at(root.menu-target-id, root.current-frame); }
                        if (item.action == 1) { root.delete-object(root.menu-target-id); }
                        if (item.action == 2) { root.add-object-at(root.menu-frame, root.menu-layer, item.kind); }
                        if (item.action == 3) { root.ripple-mode = !root.ripple-mode; }
                        if (item.action == 5) { root.undo-requested(); }
                        if (item.action == 6) { root.redo-requested(); }
                        if (item.action == 7) { root.duplicate-requested(root.menu-target-id); }
                        if (item.action == 8) { root.cut-requested(root.menu-target-id); }
                        if (item.action == 9) { root.copy-requested(root.menu-target-id); }
                        if (item.action == 10) { root.paste-requested(); }
                        root.show-context-menu = false;
                    }
                }
            }
        }
    }
    init => { key-focus.focus(); }
}
