import { LineEdit, ComboBox, Button } from "std-widgets.slint";

export component KeyframeEditorWindow inherits Window {
    title: "NeoUtl - 区間イージング編集 (標準エンジン)";
    preferred-width: 340px;
    preferred-height: 380px;
    background: #0e0e12;

    in-out property <int> object-id: -1;
    in-out property <int> effect-index: -1;
    in-out property <string> group: "";
    in-out property <string> key: "";
    in-out property <string> label: "";

    in-out property <int> segment-start-frame: 0;
    in-out property <int> segment-end-frame: 0;

    in-out property <int> easing-kind: 0;
    in-out property <[string]> easing-names: [];

    in-out property <float> bezier-cp1-x: 0.33;
    in-out property <float> bezier-cp1-y: 0;
    in-out property <float> bezier-cp2-x: 0.66;
    in-out property <float> bezier-cp2-y: 1;

    in-out property <int> random-seed: 1;
    in-out property <int> random-step: 1;

    in-out property <string> preview-path-commands: "M 0 1";

    callback easing-changed(int);
    callback bezier-changed();
    callback random-changed();
    callback apply();
    callback cancel();

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Text {
            text: root.label;
            color: #dde3ee;
            font-size: 13px;
        }

        Text {
            text: "区間 [" + root.segment-start-frame + " – " + root.segment-end-frame + "]";
            color: #8a8a96;
            font-size: 10px;
        }

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "補間種別";
                color: #8a8a96;
                font-size: 10px;
                vertical-alignment: center;
                width: 60px;
            }

            combo := ComboBox {
                model: root.easing-names;
                current-index: root.easing-kind;
                selected(v) => {
                    root.easing-kind = self.current-index;
                    root.easing-changed(self.current-index);
                }
            }
        }

        if root.easing-kind == 23: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "cp1";
                    color: #55555e;
                    font-size: 9px;
                    width: 24px;
                    vertical-alignment: center;
                }

                LineEdit {
                    text: root.bezier-cp1-x;
                    input-type: decimal;
                    edited => { root.bezier-cp1-x = self.text.to-float(); root.bezier-changed(); }
                }

                LineEdit {
                    text: root.bezier-cp1-y;
                    input-type: decimal;
                    edited => { root.bezier-cp1-y = self.text.to-float(); root.bezier-changed(); }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "cp2";
                    color: #55555e;
                    font-size: 9px;
                    width: 24px;
                    vertical-alignment: center;
                }

                LineEdit {
                    text: root.bezier-cp2-x;
                    input-type: decimal;
                    edited => { root.bezier-cp2-x = self.text.to-float(); root.bezier-changed(); }
                }

                LineEdit {
                    text: root.bezier-cp2-y;
                    input-type: decimal;
                    edited => { root.bezier-cp2-y = self.text.to-float(); root.bezier-changed(); }
                }
            }
        }

        if root.easing-kind == 24: HorizontalLayout {
            spacing: 4px;
            Text {
                text: "seed";
                color: #55555e;
                font-size: 9px;
                width: 24px;
                vertical-alignment: center;
            }

            LineEdit {
                text: root.random-seed;
                input-type: number;
                edited => { root.random-seed = self.text.to-float(); root.random-changed(); }
            }

            Text {
                text: "step";
                color: #55555e;
                font-size: 9px;
                width: 24px;
                vertical-alignment: center;
            }

            LineEdit {
                text: root.random-step;
                input-type: number;
                edited => { root.random-step = self.text.to-float(); root.random-changed(); }
            }
        }

        Rectangle {
            height: 140px;
            border-radius: 3px;
            background: #16161b;
            border-width: 1px;
            border-color: #303038;

            Path {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                stroke: #3a6df0;
                stroke-width: 1.5px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 1;
                viewbox-height: 1;
                commands: root.preview-path-commands;
            }
        }

        Rectangle { }

        HorizontalLayout {
            height: 26px;
            spacing: 6px;

            Rectangle { }

            Rectangle {
                width: 60px;
                border-radius: 3px;
                background: #1e1e24;
                border-width: 1px;
                border-color: #303038;

                Text {
                    text: "閉じる";
                    color: #8a8a96;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                TouchArea {
                    clicked => { root.cancel(); }
                }
            }

            Rectangle {
                width: 60px;
                border-radius: 3px;
                background: #2a4db8;

                Text {
                    text: "適用";
                    color: #ffffff;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                TouchArea {
                    clicked => { root.apply(); }
                }
            }
        }
    }
}
